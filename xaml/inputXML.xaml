            <TabItem Header="Windows 镜像" Visibility="Collapsed" Name="WPFTab5">
                <Grid Name="Win11ISOPanel" Margin="{DynamicResource TabContentMargin}" Background="Transparent">
                    <Grid.Resources>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Width" Value="Auto"/>
                            <Setter Property="Height" Value="Auto"/>
                            <Setter Property="MinHeight" Value="{DynamicResource ButtonHeight}"/>
                            <Setter Property="Padding" Value="12,8"/>
                            <Setter Property="HorizontalAlignment" Value="Left"/>
                            <Setter Property="ContentTemplate">
                                <Setter.Value><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center"/></DataTemplate></Setter.Value>
                            </Setter>
                        </Style>
                        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                            <Setter Property="FontSize" Value="{DynamicResource FontSize}"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ComboBox">
                                        <Grid>
                                            <Border Name="ISOComboBorder" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="4">
                                                <Grid>
                                                    <ToggleButton Name="ToggleButton" Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press">
                                                        <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"/></ControlTemplate></ToggleButton.Template>
                                                    </ToggleButton>
                                                    <Grid IsHitTestVisible="False" Margin="8,6">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
                                                        <TextBlock Name="ISOSelectionText" Text="{TemplateBinding SelectionBoxItem}" TextWrapping="Wrap" FontSize="{TemplateBinding FontSize}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                                                        <Path Name="ISOSelectionArrow" Grid.Column="1" Data="M 0,0 L 8,0 L 4,5 Z" Fill="{TemplateBinding Foreground}" Width="8" Height="5" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                            <Popup Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
                                                <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="4" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                                    <ScrollViewer MaxHeight="320" CanContentScroll="True"><ItemsPresenter Margin="4"/></ScrollViewer>
                                                </Border>
                                            </Popup>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger>
                                            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ISOComboBorder" Property="BorderBrush" Value="{DynamicResource AccentColor}"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="FontSize" Value="{DynamicResource FontSize}"/>
                        </Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="FontSize" Value="{DynamicResource FontSize}"/>
                            <Setter Property="Foreground" Value="{DynamicResource MainForegroundColor}"/>
                        </Style>
                    </Grid.Resources>
                    <ScrollViewer Name="WPFWindowsISOScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel MaxWidth="1000" HorizontalAlignment="Stretch" Margin="0,0,12,16">
                            <StackPanel Name="WPFWin11ISOSelectSection">
                                <TextBlock Text="准备 Windows 安装镜像" FontSize="{DynamicResource HeaderFontSize}" FontWeight="SemiBold"/>
                                <TextBlock Text="使用微软原版 Windows 10 或 Windows 11 的 x64 ISO，制作供全新安装使用的镜像。系统与版本会在读取 ISO 后自动识别。" Foreground="{DynamicResource SecondaryForegroundColor}" Margin="0,6,0,16"/>
                                <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1" Padding="0,0,0,18" Margin="0,0,0,18">
                                    <StackPanel>
                                        <TextBlock Text="还没有 ISO？" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <WrapPanel>
                                            <ComboBox Name="WPFWindowsISODownloadVersion" SelectedIndex="0" MinWidth="{DynamicResource ButtonWidth}" Margin="0,0,8,8" VerticalAlignment="Center" AutomationProperties.Name="要下载的 Windows 系统">
                                                <ComboBoxItem Content="Windows 11（x64）" Tag="Windows11"/>
                                                <ComboBoxItem Content="Windows 10 22H2（x64）" Tag="Windows10"/>
                                            </ComboBox>
                                            <Button Name="WPFWin11ISODownloadLink" Content="打开微软下载页" Margin="0,0,0,8"/>
                                        </WrapPanel>
                                        <TextBlock Name="WPFWindowsISODownloadHint" Text="在微软网页选择语言和 64 位 ISO；Windows 10 页面也可能提供媒体创建工具。" Foreground="{DynamicResource SecondaryForegroundColor}"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="1. 选择本地 ISO" FontSize="{DynamicResource HeaderFontSize}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBox Name="WPFWin11ISOPath" IsReadOnly="True" VerticalAlignment="Center" Padding="8,6" Margin="0,0,8,0" Text="未选择 ISO..." AutomationProperties.Name="所选 ISO 文件"/>
                                    <Button Grid.Column="1" Name="WPFWin11ISOBrowseButton" Content="选择文件…"/>
                                </Grid>
                                <TextBlock Name="WPFWin11ISOFileInfo" Margin="0,8,0,0" Visibility="Collapsed"/>
                            </StackPanel>

                            <StackPanel Name="WPFWin11ISOMountSection" Visibility="Collapsed" Margin="0,24,0,0">
                                <TextBlock Text="2. 读取镜像与选择版本" FontSize="{DynamicResource HeaderFontSize}" FontWeight="SemiBold"/>
                                <TextBlock Text="挂载 ISO，检查 install.wim / install.esd 中的系统、架构及版本。此步骤不安装 Windows，也不会修改原始 ISO。" Foreground="{DynamicResource SecondaryForegroundColor}" Margin="0,6,0,10"/>
                                <Button Name="WPFWin11ISOMountButton" Content="读取镜像信息"/>
                                <Border Name="WPFWin11ISOVerifyResultPanel" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="4" Padding="14" Margin="0,12,0,0" Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock Name="WPFWin11ISOMountDriveLetter" Margin="0,0,0,4"/>
                                        <TextBlock Name="WPFWin11ISOArchLabel" Margin="0,0,0,10"/>
                                        <TextBlock Text="要制作的版本" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                        <ComboBox Name="WPFWin11ISOEditionComboBox" MinWidth="0" HorizontalAlignment="Stretch" AutomationProperties.Name="要制作的 Windows 版本"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Name="WPFWin11ISOModifySection" Visibility="Collapsed" Margin="0,24,0,0">
                                <TextBlock Text="3. 制作安装镜像" FontSize="{DynamicResource HeaderFontSize}" FontWeight="SemiBold"/>
                                <TextBlock Name="WPFWindowsISOProfileSummary" Text="在独立临时目录中复制文件，移除预装应用并应用镜像设置。Windows 10 和 Windows 11 使用各自的安装配置，原始 ISO 保持不变。" Foreground="{DynamicResource SecondaryForegroundColor}" Margin="0,6,0,10"/>
                                <CheckBox Name="WPFWin11ISOInjectDrivers" IsChecked="False" Margin="0,2,0,12">
                                    <TextBlock Text="加入本机驱动（仅用于同一台电脑或相同硬件）"/>
                                </CheckBox>
                                <Button Name="WPFWin11ISOModifyButton" Content="开始制作"/>
                            </StackPanel>

                            <StackPanel Name="WPFWin11ISOOutputSection" Visibility="Collapsed" Margin="0,24,0,0">
                                <TextBlock Text="4. 保存或写入 U 盘" FontSize="{DynamicResource HeaderFontSize}" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <WrapPanel>
                                    <Button Name="WPFWin11ISOChooseISOButton" Content="保存为 ISO 文件…" Margin="0,0,8,8"/>
                                    <Button Name="WPFWin11ISOChooseUSBButton" Content="写入 U 盘…" Margin="0,0,8,8"/>
                                </WrapPanel>
                                <Border Name="WPFWin11ISOOptionUSB" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="4" Padding="14" Margin="0,4,0,0" Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock Text="写入会擦除所选 U 盘的全部数据。请先备份，并核对磁盘名称与容量。" FontWeight="SemiBold" Foreground="{DynamicResource DangerForegroundColor}" Margin="0,0,0,10"/>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <ComboBox Name="WPFWin11ISOUSBDriveComboBox" MinWidth="0" Margin="0,0,8,0" VerticalAlignment="Center" AutomationProperties.Name="要写入的 U 盘"/>
                                            <Button Grid.Column="1" Name="WPFWin11ISORefreshUSBButton" Content="刷新"/>
                                        </Grid>
                                        <Button Name="WPFWin11ISOWriteUSBButton" Content="擦除并写入 U 盘"/>
                                    </StackPanel>
                                </Border>
