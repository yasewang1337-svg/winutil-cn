            <TabItem Header="更新" Visibility="Collapsed" Name="WPFTab4">
                <TabItem.Resources>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Setter Property="Width" Value="Auto"/>
                        <Setter Property="Height" Value="Auto"/>
                        <Setter Property="MinWidth" Value="132"/>
                        <Setter Property="HorizontalAlignment" Value="Left"/>
                        <Setter Property="Padding" Value="12,8"/>
                        <Setter Property="Margin" Value="0,12,0,0"/>
                        <Setter Property="FontSize" Value="{DynamicResource ConfigTabButtonFontSize}"/>
                        <Setter Property="ContentTemplate">
                            <Setter.Value>
                                <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="{DynamicResource ConfigTabButtonFontSize}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></DataTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <Style x:Key="UpdatePolicyText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                        <Setter Property="TextWrapping" Value="Wrap"/>
                        <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundColor}"/>
                        <Setter Property="Margin" Value="0,6,0,0"/>
                    </Style>
                </TabItem.Resources>
                <ScrollViewer Name="WPFUpdatesScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,12">
                    <StackPanel Name="WPFUpdatesSettingsList" HorizontalAlignment="Stretch">
                        <TextBlock Style="{StaticResource UpdatePolicyText}" Text="选择需要的更新策略。点击下方按钮会立即修改设置；部分改动需要重启后生效。" Margin="0,0,0,12"/>

                        <Border Style="{StaticResource BorderStyle}" Margin="0,0,0,12" Padding="16">
                            <StackPanel>
                                <TextBlock Name="WPFUpdatesDefaultTitle" Text="恢复更新配置" FontSize="{DynamicResource HeaderFontSize}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Style="{StaticResource UpdatePolicyText}" Text="清理 Windows Update、驱动搜索和传递优化相关配置，重新启用更新服务及计划任务，并恢复设置中的 Windows 更新入口。"/>
                                <TextBlock Style="{StaticResource UpdatePolicyText}" Text="会移除相关策略分支及设置页可见性策略，可能影响已有自定义配置；不会重置整个 Windows，也不能还原原先的自定义值。"/>
                                <Button Name="WPFUpdatesdefault" Content="恢复更新配置"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource BorderStyle}" Margin="0,0,0,12" Padding="16">
                            <StackPanel>
                                <TextBlock Name="WPFUpdatesSecurityTitle" Text="延迟更新" FontSize="{DynamicResource HeaderFontSize}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Style="{StaticResource UpdatePolicyText}" Text="写入功能更新延迟 365 天、质量更新延迟 4 天的配置，并限制通过 Windows Update 提供驱动。质量更新包含安全修复。"/>
                                <TextBlock Style="{StaticResource UpdatePolicyText}" Text="同时写入用户登录时不自动重启的更新策略。实际效果取决于 Windows 版本、策略支持情况及组织配置；延迟天数并不保证在所有系统上生效。"/>
                                <Button Name="WPFUpdatessecurity" Content="应用延迟策略"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource BorderStyle}" Margin="0,0,0,12" Padding="16">
                            <StackPanel>
                                <TextBlock Name="WPFUpdatesDisableTitle" Text="禁用更新（不推荐）" FontSize="{DynamicResource HeaderFontSize}" FontWeight="SemiBold" Foreground="{DynamicResource DangerForegroundColor}" TextWrapping="Wrap"/>
                                <TextBlock Style="{StaticResource UpdatePolicyText}" Text="禁用更新相关服务和计划任务，清理更新下载缓存，并隐藏设置中的 Windows 更新入口。不是临时暂停，也不保证系统或组织策略不会重新启用更新。"/>
                                <TextBlock Style="{StaticResource UpdatePolicyText}" Text="会妨碍安全修复的获取，只应在明确了解影响时使用。需要恢复时，可选择上方“恢复更新配置”。"/>
                                <Button Name="WPFUpdatesdisable" Content="禁用更新" Foreground="{DynamicResource DangerForegroundColor}"/>
                            </StackPanel>
                        </Border>
                        <Grid Name="updatespanel" Background="Transparent"/>
                    </StackPanel>
                </ScrollViewer>
